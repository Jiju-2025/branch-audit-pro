      { key: 'pan', label: 'Pan Number' },
      { key: 'agent', label: 'Agent' },
      { key: 'remarks', label: 'Remarks' },
    ],
  },
];

function emptyRow(columns: { key: string }[]): Row {
  const row: Row = {};
  columns.forEach((c) => { row[c.key] = ''; });
  return row;
}interface Props {
  data: Record<string, Row[]>;
  onChange: (key: string, rows: Row[]) => void;
  hospitalNotes: string;
  vouchersNotes: string;
  pendingIrregularities: string;
  onFieldChange: (field: string, value: string) => void;
  readOnly?: boolean;
}

export default function Annexure1({
  data,
  onChange,
  hospitalNotes,
  vouchersNotes,
  pendingIrregularities,
  onFieldChange,
  readOnly,
}: Props) {
  const addRow = (tableKey: string, columns: { key: string }[]) => {
    const rows = [...(data[tableKey] || [])];
    rows.push(emptyRow(columns));
    onChange(tableKey, rows);
  };

  const removeRow = (tableKey: string, index: number) => {
    const rows = (data[tableKey] || []).filter((_, i) => i !== index);
    onChange(tableKey, rows);
  };

  const updateCell = (tableKey: string, index: number, colKey: string, value: string) => {
    const rows = [...(data[tableKey] || [])];
    rows[index] = { ...rows[index], [colKey]: value };
    onChange(tableKey, rows);
  };

  return (
    <div className="space-y-6">
      <h3 className="text-base font-bold text-teal-800 border-b-2 border-teal-500 pb-1">
        ANNEXURE 1 – DOCUMENTS VERIFICATION
      </h3>

      <div className="bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 text-sm font-semibold text-amber-900">
        GOLD LOAN
      </div>

      {TABLES.filter((t) => t.key.startsWith('gl_')).map((table) => (
        <div key={table.key} className="border rounded-lg overflow-hidden">
          <div className="bg-slate-100 px-3 py-2 text-sm font-medium">{table.title}</div>
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead className="bg-gray-50">
                <tr>
                  {table.columns.map((c) => (
                    <th key={c.key} className="text-left px-2 py-1.5 font-medium whitespace-nowrap">{c.label}</th>
                  ))}
                  {!readOnly && <th className="w-10"></th>}
                </tr>
              </thead>
              <tbody>
                {(data[table.key] || []).map((row, i) => (
                  <tr key={i} className="border-t">
                    {table.columns.map((c) => (
                      <td key={c.key} className="px-1 py-1">
                        <input
                          value={row[c.key] || ''}
                          onChange={(e) => updateCell(table.key, i, c.key, e.target.value)}
                          disabled={readOnly}
                          className="w-full border rounded px-1.5 py-1 min-w-[90px]"
                        />
                      </td>
                    ))}
                    {!readOnly && (
                      <td>
                        <button type="button" onClick={() => removeRow(table.key, i)} className="text-red-500 p-1">
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </td>
                    )}
                  </tr>
                ))}
                {(data[table.key] || []).length === 0 && (
                  <tr>
                    <td colSpan={table.columns.length + (readOnly ? 0 : 1)} className="px-3 py-3 text-gray-400 text-center text-xs">
                      No rows. Click Add Row.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
          {!readOnly && (
            <button
              type="button"
              onClick={() => addRow(table.key, table.columns)}
              className="m-2 text-xs text-blue-600 flex items-center gap-1"
            >
              <Plus className="w-3.5 h-3.5" /> Add Row
            </button>
          )}
        </div>
      ))}

      <div className="border rounded-lg p-3 space-y-2">
        <div className="text-sm font-medium bg-teal-50 text-teal-900 px-2 py-1 rounded">HOSPITAL APPLICATION VERIFICATION</div>
        <textarea
          value={hospitalNotes}
          onChange={(e) => onFieldChange('hospital_notes', e.target.value)}
          disabled={readOnly}
          rows={2}
          className="w-full border rounded-lg px-3 py-2 text-sm"
          placeholder="Notes / findings..."
        />
      </div>

      {TABLES.filter((t) => t.key === 'kyc_verification').map((table) => (
        <div key={table.key} className="border rounded-lg overflow-hidden">
          <div className="bg-teal-50 px-3 py-2 text-sm font-medium text-teal-900">{table.title}</div>
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead className="bg-gray-50">
                <tr>
                  {table.columns.map((c) => (
                    <th key={c.key} className="text-left px-2 py-1.5 font-medium whitespace-nowrap">{c.label}</th>
                  ))}
                  {!readOnly && <th className="w-10"></th>}
                </tr>
              </thead>
              <tbody>
                {(data[table.key] || []).map((row, i) => (
                  <tr key={i} className="border-t">
                    {table.columns.map((c) => (
                      <td key={c.key} className="px-1 py-1">
                        <input
                          value={row[c.key] || ''}
                          onChange={(e) => updateCell(table.key, i, c.key, e.target.value)}
                          disabled={readOnly}
                          className="w-full border rounded px-1.5 py-1 min-w-[90px]"
                        />
                      </td>
                    ))}
                    {!readOnly && (
                      <td>
                        <button type="button" onClick={() => removeRow(table.key, i)} className="text-red-500 p-1">
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {!readOnly && (
            <button type="button" onClick={() => addRow(table.key, table.columns)} className="m-2 text-xs text-blue-600 flex items-center gap-1">
              <Plus className="w-3.5 h-3.5" /> Add Row
            </button>
          )}
        </div>
      ))}

      <div className="border rounded-lg p-3 space-y-2">
        <div className="text-sm font-medium bg-teal-50 text-teal-900 px-2 py-1 rounded">VOUCHERS VERIFICATION</div>
        <textarea
          value={vouchersNotes}
          onChange={(e) => onFieldChange('vouchers_notes', e.target.value)}
          disabled={readOnly}
          rows={2}
          className="w-full border rounded-lg px-3 py-2 text-sm"
          placeholder="Notes / findings..."
        />
      </div>

      <div className="border rounded-lg p-3 space-y-2">
        <div className="text-sm font-medium bg-teal-50 text-teal-900 px-2 py-1 rounded">PENDING IRREGULARITIES</div>
        <textarea
          value={pendingIrregularities}
          onChange={(e) => onFieldChange('annex1_pending_irregularities', e.target.value)}
          disabled={readOnly}
          rows={3}
          className="w-full border rounded-lg px-3 py-2 text-sm"
          placeholder="List pending irregularities..."
        />
      </div>
    </div>
  );
}
