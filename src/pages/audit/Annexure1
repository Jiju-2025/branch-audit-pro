  },
  {
    key: 'kyc_verification',
    title: 'KYC Verification',
    columns: [
      { key: 'application_date', label: 'Application Date' },
      { key: 'name', label: 'Name' },
      { key: 'share_number', label: 'Share Number' },
      { key: 'address', label: 'Address' },
