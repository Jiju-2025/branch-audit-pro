      { key: 'amount', label: 'Amount' },
    ],
  },
  {
    key: 'gl_pledge_photo',
    title: 'e) Pledge form – Customer live photo and ornament photos',
    columns: [
      { key: 'scheme', label: 'Scheme' },
      { key: 'loan_no', label: 'Loan No' },
      { key: 'loan_date', label: 'Loan Date' },
      { key: 'customer_name', label: 'Customer Name' },
      { key: 'loan_amount', label: 'Loan Amount' },
    ],
  },
  {
    key: 'gl_pledge_issues',
    title: 'f) Pledge related issues',
    columns: [
      { key: 'account_no', label: 'Account No' },
      { key: 'name', label: 'Name' },
      { key: 'open_date', label: 'Open Date' },
      { key: 'amount', label: 'Amount' },
      { key: 'remarks', label: 'Remarks' },
    ],
  },
  {
    key: 'gl_released_docs',
    title: 'g) Released documents related issues',
    columns: [
      { key: 'loan_date', label: 'Loan Date' },
      { key: 'close_date', label: 'Close Date' },
      { key: 'customer_name', label: 'Customer Name' },
      { key: 'loan_no', label: 'Loan No.' },
      { key: 'principle_amt', label: 'Principle Amt.' },
      { key: 'remarks', label: 'Remarks' },
    ],
  },
  {
    key: 'gl_ctfs',
    title: 'h) CTFS documents related issues',
    columns: [
      { key: 'deposit_no', label: 'Deposit No' },
      { key: 'deposit_date', label: 'Deposit Date' },
