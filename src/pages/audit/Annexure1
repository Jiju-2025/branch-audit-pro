    columns: [
      { key: 'loan_date', label: 'Loan Date' },
      { key: 'close_date', label: 'Close Date' },
      { key: 'customer_name', label: 'Customer Name' },
      { key: 'loan_no', label: 'Loan No.' },
      { key: 'principle_amt', label: 'Principle Amt.' },
    ],
  },
  {
    key: 'gl_release_sign_mismatch',
    title: 'b) Release sign mismatches cases',
    columns: [
      { key: 'loan_date', label: 'Loan Date' },
      { key: 'close_date', label: 'Close Date' },
      { key: 'customer_name', label: 'Customer Name' },
      { key: 'loan_no', label: 'Loan No.' },
      { key: 'principle_amt', label: 'Principle Amt.' },
    ],
  },
  {
    key: 'gl_release_sign_missing',
    title: 'c) Release sign missing case',
    columns: [
      { key: 'loan_date', label: 'Loan Date' },
      { key: 'close_date', label: 'Close Date' },
      { key: 'customer_name', label: 'Customer Name' },
      { key: 'loan_no', label: 'Loan No.' },
      { key: 'principle_amt', label: 'Principle Amt.' },
    ],
  },
  {
    key: 'gl_declaration_missing',
